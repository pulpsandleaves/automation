{
  "version": "7.3",
  "routing_model": {
    "WELCOME_SCREEN": [
      "CITY_SCREEN"
    ],
    "CITY_SCREEN": [
      "BOX_SCREEN"
    ],
    "BOX_SCREEN": [
      "CUSTOMER_SCREEN"
    ],
    "CUSTOMER_SCREEN": [
      "REVIEW_SCREEN"
    ],
    "REVIEW_SCREEN": []
  },
  "screens": [
    {
      "id": "WELCOME_SCREEN",
      "title": "Pulps & Leaves",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "https://pulps-and-leaves-whatsapp-automation.onrender.com/assets/main.png",
            "height": 220,
            "scale-type": "cover"
          },
          {
            "type": "TextHeading",
            "text": "Pulps & Leaves Premium Malda Mangoes"
          },
          {
            "type": "TextBody",
            "text": "Build your mango box, choose your city, add delivery details, and place the order inside WhatsApp."
          },
          {
            "type": "TextBody",
            "text": "Flat 10% off. Free delivery on orders above Rs 599."
          },
          {
            "type": "Form",
            "name": "welcome_form",
            "children": [
              {
                "type": "Footer",
                "label": "Start Order",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CITY_SCREEN"
                  },
                  "payload": {}
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CITY_SCREEN",
      "title": "Delivery City",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Where should we deliver?"
          },
          {
            "type": "TextBody",
            "text": "Choose your city so the team can route the order correctly."
          },
          {
            "type": "Form",
            "name": "city_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "city",
                "label": "City",
                "required": true,
                "data-source": [
                  {
                    "id": "bangalore",
                    "title": "Bangalore"
                  },
                  {
                    "id": "hyderabad",
                    "title": "Hyderabad"
                  },
                  {
                    "id": "pune",
                    "title": "Pune"
                  },
                  {
                    "id": "mumbai",
                    "title": "Mumbai"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Choose Boxes",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "BOX_SCREEN"
                  },
                  "payload": {
                    "city": "${form.city}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BOX_SCREEN",
      "title": "Mango Boxes",
      "data": {
        "city": {
          "type": "string",
          "__example__": "bangalore"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "https://pulps-and-leaves-whatsapp-automation.onrender.com/assets/welcome_template.png",
            "height": 180,
            "scale-type": "cover"
          },
          {
            "type": "TextHeading",
            "text": "Pick your box"
          },
          {
            "type": "TextBody",
            "text": "3 kg box: Rs 599. 5 kg box: Rs 999. Discount and delivery charges are calculated automatically after submission."
          },
          {
            "type": "Form",
            "name": "box_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "box_combo",
                "label": "Box selection",
                "required": true,
                "data-source": [
                  {
                    "id": "3kg_1",
                    "title": "3 kg x 1 - Rs 599"
                  },
                  {
                    "id": "3kg_2",
                    "title": "3 kg x 2 - Rs 1198"
                  },
                  {
                    "id": "5kg_1",
                    "title": "5 kg x 1 - Rs 999"
                  },
                  {
                    "id": "5kg_2",
                    "title": "5 kg x 2 - Rs 1998"
                  },
                  {
                    "id": "combo_1_1",
                    "title": "3 kg x 1 + 5 kg x 1"
                  },
                  {
                    "id": "combo_2_1",
                    "title": "3 kg x 2 + 5 kg x 1"
                  },
                  {
                    "id": "combo_1_2",
                    "title": "3 kg x 1 + 5 kg x 2"
                  },
                  {
                    "id": "combo_2_2",
                    "title": "3 kg x 2 + 5 kg x 2"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Add Details",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CUSTOMER_SCREEN"
                  },
                  "payload": {
                    "city": "${data.city}",
                    "box_combo": "${form.box_combo}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CUSTOMER_SCREEN",
      "title": "Delivery Details",
      "data": {
        "city": {
          "type": "string",
          "__example__": "bangalore"
        },
        "box_combo": {
          "type": "string",
          "__example__": "combo_1_1"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Almost ready"
          },
          {
            "type": "TextBody",
            "text": "Share the delivery details for your fresh mango box."
          },
          {
            "type": "Form",
            "name": "customer_form",
            "children": [
              {
                "type": "TextInput",
                "name": "customer_name",
                "label": "Full name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "mobile_number",
                "label": "WhatsApp mobile number",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "TextArea",
                "name": "delivery_address",
                "label": "Full delivery address",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "payment_method",
                "label": "Payment mode",
                "required": true,
                "data-source": [
                  {
                    "id": "cod",
                    "title": "Cash on Delivery"
                  },
                  {
                    "id": "upi_on_delivery",
                    "title": "UPI on Delivery"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Review",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "REVIEW_SCREEN"
                  },
                  "payload": {
                    "city": "${data.city}",
                    "box_combo": "${data.box_combo}",
                    "customer_name": "${form.customer_name}",
                    "mobile_number": "${form.mobile_number}",
                    "delivery_address": "${form.delivery_address}",
                    "payment_method": "${form.payment_method}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REVIEW_SCREEN",
      "title": "Confirm Order",
      "terminal": true,
      "success": true,
      "data": {
        "city": {
          "type": "string",
          "__example__": "bangalore"
        },
        "box_combo": {
          "type": "string",
          "__example__": "combo_1_1"
        },
        "customer_name": {
          "type": "string",
          "__example__": "Rohit Sharma"
        },
        "mobile_number": {
          "type": "string",
          "__example__": "9835496666"
        },
        "delivery_address": {
          "type": "string",
          "__example__": "Flat 888, Whitefield, Bangalore"
        },
        "payment_method": {
          "type": "string",
          "__example__": "cod"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "https://pulps-and-leaves-whatsapp-automation.onrender.com/assets/order_delivered_header.png",
            "height": 160,
            "scale-type": "cover"
          },
          {
            "type": "TextHeading",
            "text": "Confirm your order"
          },
          {
            "type": "TextBody",
            "text": "Tap Confirm Order. Your order will be saved, and the approved WhatsApp confirmation template will be sent automatically."
          },
          {
            "type": "Form",
            "name": "review_form",
            "children": [
              {
                "type": "Footer",
                "label": "Confirm Order",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "flow_name": "mango_whatsapp_order",
                    "city": "${data.city}",
                    "box_combo": "${data.box_combo}",
                    "customer_name": "${data.customer_name}",
                    "mobile_number": "${data.mobile_number}",
                    "delivery_address": "${data.delivery_address}",
                    "payment_method": "${data.payment_method}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
