ORDER_CONFIRMATION_TEMPLATE_LANGUAGE=en_US
BULK_MESSAGE_TEMPLATE_NAME=say_hi
BULK_MESSAGE_TEMPLATE_LANGUAGE=en_US

# Admin and security
ADMIN_WHATSAPP_NUMBER=919835496666
SUPPORT_NUMBER=919835496666
ORDER_API_SECRET=
ADMIN_DASHBOARD_TOKEN=
OUTBOUND_CONFIRMATION_SECRET=

# SQLite backup
ORDER_SQLITE_PATH=/tmp/pulps_orders.db

# Existing chat bot assets
