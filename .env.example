FLASK_ENV=development
LOG_LEVEL=INFO

# Google Sheets
GOOGLE_SHEET_NAME=PulpsAndLeavesOrders
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=orders
ECOMMERCE_ORDERS_WORKSHEET_NAME=orders
GOOGLE_DAILY_WORKSHEET_PREFIX=orders
WHATSAPP_CONTACTS_WORKSHEET_NAME=WhatsApp Contacts
WHATSAPP_CONVERSATIONS_WORKSHEET_NAME=WhatsApp Conversations
CHAT_CONTACT_CACHE_SECONDS=15
CHAT_MESSAGE_CACHE_SECONDS=8
HUMAN_CHAT_IDLE_MINUTES=1440
AUTO_CONFIRMATIONS_INTERVAL_SECONDS=300
SHEETS_RATE_LIMIT_BACKOFF_SECONDS=300
AUTO_CONFIRMATION_BATCH_LIMIT=3
AUTO_STATUS_UPDATE_BATCH_LIMIT=5
AUTO_CUSTOM_MESSAGE_BATCH_LIMIT=5
WEBHOOK_QUEUE_MAX_SIZE=200
OPERATOR_MEDIA_UPLOAD_MAX_BYTES=16777216
LOCAL_TIMEZONE=Asia/Kolkata
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_CREDENTIALS_JSON=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=pulps-leaves-test-123
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
